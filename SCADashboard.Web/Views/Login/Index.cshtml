@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="zxx" class="js">

<head>
    <base href="../../../">
    <meta charset="utf-8">
    <meta name="author" content="Softnio">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="A powerful and conceptual apps base dashboard template that especially build for developers and programmers.">
    <!-- Fav Icon  -->
    <link rel="shortcut icon" href="./images/favicon.png">
    <!-- Page Title  -->
    <title>Login | SCA Logistik & Fulfillment GmbH </title>
    <!-- StyleSheets  -->
    <link rel="stylesheet" href="./assets/css/dashlite.css?ver=3.2.3">
    <link id="skin-default" rel="stylesheet" href="./assets/css/theme.css?ver=3.2.3">
    <style>
        #pageLoader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }
    </style>
</head>

<body class="nk-body ui-rounder npc-general pg-auth">
    <div class="nk-app-root">
        <!-- main s -->
        <div class="nk-main ">
            <!-- wrap s -->
            <div class="nk-wrap nk-wrap-nosidebar">
                <!-- content s -->
                <div class="nk-content ">
                    <div class="nk-split nk-split-page nk-split-lg">
                        <div class="nk-split-content nk-block-area nk-block-area-column nk-auth-container bg-white">
                            <div class="absolute-top-right d-lg-none p-3 p-sm-5">
                                <a href="#" class="toggle btn-white btn btn-icon btn-light" data-target="athPromo"><em class="icon ni ni-info"></em></a>
                            </div>
                            <div class="nk-block nk-block-middle nk-auth-body">
                                <div class="brand-logo pb-5">
                                    <a href="@Url.Action("Index", "Login")" class="logo-link">
                                        <img class="logo-light logo-img logo-img-lg" src="./images/logo.png" srcset="./images/logo2x.png 2x" alt="logo">
                                        <img class="logo-dark logo-img logo-img-lg" src="./images/logo-dark.png" srcset="./images/logo-dark2x.png 2x" alt="logo-dark">
                                    </a>
                                </div>
                                <div class="nk-block-head">
                                    <div class="nk-block-head-content">
                                        <h5 class="nk-block-title">Sign-In</h5>
                                        <div class="nk-block-des">
                                            <p>Access the SCA DashBoard panel using your email and passcode.</p>
                                        </div>
                                    </div>
                                </div><!-- .nk-block-head -->
                                <form id="LoginForm" class="form-validate is-alter" autocomplete="off">
                                    <div class="form-group">
                                        <div class="form-label-group">
                                            <label class="form-label" for="email-address">Email or Username</label>
                                            @* <a class="link link-primary link-sm" tabindex="-1" href="#">Need Help?</a> *@
                                        </div>
                                        <div class="form-control-wrap">
                                            <input autocomplete="off" type="text" class="form-control form-control-lg" required id="email-address" placeholder="Enter your email address or username">
                                        </div>
                                    </div><!-- .form-group -->
                                    <div class="form-group">
                                        <div class="form-label-group">
                                            <label class="form-label" for="password">Passcode</label>
                                            <a class="link link-primary link-sm" tabindex="-1" href="@Url.ActionLink("ForgetPassword", "Login")">Forgot Code?</a>
                                        </div>
                                        <div class="form-control-wrap">
                                            <a tabindex="-1" href="#" class="form-icon form-icon-right passcode-switch lg" data-target="password">
                                                <em class="passcode-icon icon-show icon ni ni-eye"></em>
                                                <em class="passcode-icon icon-hide icon ni ni-eye-off"></em>
                                            </a>
                                            <input autocomplete="new-password" type="password" class="form-control form-control-lg" required id="password" placeholder="Enter your passcode">
                                        </div>
                                    </div><!-- .form-group -->
                                    <div class="form-group">
                                        <div id="captcha-container" style="margin-top: 10px;">
                                            <div class="g-recaptcha" data-sitekey="6LfmrxcsAAAAAOg8mJZ4JqcwusN0s_aEfnkj2ajx"></div>
                                        </div>
                                        <p id="captchaError" style="color: red"></p>
                                        <button type="submit" class="btn btn-lg btn-primary btn-block">Sign in</button>
                                        
                                    </div>
                                </form><!-- form -->
                                <div id="ErrorMessage" class="mt-3"></div>
                            </div><!-- .nk-block -->
                            <div class="nk-block nk-auth-footer">
                                <div class="nk-block-between">
                                    <ul class="nav nav-sm">
                                        <li class="nav-item">
                                            <a class="link link-primary fw-normal py-2 px-3" href="@Url.ActionLink("TermsCondition", "Login")">Terms & Condition</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="link link-primary fw-normal py-2 px-3" href="@Url.ActionLink("PrivacyPolicy", "Login")">Privacy Policy</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="link link-primary fw-normal py-2 px-3" href="@Url.ActionLink("Help", "Login")">Help</a>
                                        </li>
                                    </ul><!-- .nav -->
                                </div>
                                <div class="mt-3">
                                    <p>&copy; @DateTime.Now.Year SCA Logistik & Fulfillment GmbH. All Rights Reserved.</p>
                                </div>
                            </div><!-- .nk-block -->
                        </div><!-- .nk-split-content -->
                        <div class="nk-split-content nk-split-stretch bg-lighter d-flex toggle-break-lg toggle-slide toggle-slide-right" data-toggle-body="true" data-content="athPromo" data-toggle-screen="lg" data-toggle-overlay="true">
                            <div class="slider-wrap w-100 w-max-550px p-3 p-sm-5 m-auto">
                                <div class="slider-init" data-slick='{"dots":true, "arrows":false}'>
                                    <div class="slider-item">
                                        <div class="nk-feature nk-feature-center">
                                            <div class="nk-feature-img">
                                                <img class="round" src="./images/slides/promo-a.jpg" srcset="./images/slides/promo-a.jpg 2x" alt="">
                                            </div>
                                            <div class="nk-feature-content py-4 p-sm-5">
                                                <h4>SCA Logistik & Fulfillment GmbH</h4>
                                                <p>You can start to create your products easily with its user-friendly design & most completed responsive layout.</p>
                                            </div>
                                        </div>
                                    </div><!-- .slider-item -->
                                    <div class="slider-item">
                                        <div class="nk-feature nk-feature-center">
                                            <div class="nk-feature-img">
                                                <img class="round" src="./images/slides/promo-b.jpg" srcset="./images/slides/promo-b.jpg 2x" alt="">
                                            </div>
                                            <div class="nk-feature-content py-4 p-sm-5">
                                                <h4>SCA Logistik & Fulfillment GmbH</h4>
                                                <p>You can start to create your products easily with its user-friendly design & most completed responsive layout.</p>
                                            </div>
                                        </div>
                                    </div><!-- .slider-item -->
                                    <div class="slider-item">
                                        <div class="nk-feature nk-feature-center">
                                            <div class="nk-feature-img">
                                                <img class="round" src="./images/slides/promo-c.png" srcset="./images/slides/promo-c.png 2x" alt="">
                                            </div>
                                            <div class="nk-feature-content py-4 p-sm-5">
                                                <h4>SCA Logistik & Fulfillment GmbH</h4>
                                                <p>You can start to create your products easily with its user-friendly design & most completed responsive layout.</p>
                                            </div>
                                        </div>
                                    </div><!-- .slider-item -->
                                </div><!-- .slider-init -->
                                <div class="slider-dots"></div>
                                <div class="slider-arrows"></div>
                            </div><!-- .slider-wrap -->
                        </div><!-- .nk-split-content -->
                    </div><!-- .nk-split -->
                </div>
                <!-- wrap e -->
            </div>
            <!-- content e -->
        </div>
        <!-- main e -->
    </div>
    <!-- app-root e -->
    <!-- Loader -->
    <div class="js-preloader">
        <div class="loading-animation tri-ring"></div>
    </div>
    <!-- Loader -->
    <div id="pageLoader" style="display:none;">
        <div class="spinner-border"></div>
    </div>
    @* <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="./assets/js/bundle.js?ver=3.2.3"></script>
    <script src="./assets/js/scripts.js?ver=3.2.3"></script>
    <script src="./assets/js/example-toastr.js?ver=3.2.3"></script>
    <script src="./assets/js/custom-toast.js"></script>

    <script>
        $("#LoginForm").on("submit", function (e) {
            if($("#LoginForm").valid())
                {
                    e.preventDefault();
                    const formData = {
                        // Username: $("#username").val(),
                        Email: $("#email-address").val(),
                        PasswordHash: $("#password").val(),
                        captcha:grecaptcha.getResponse()
                    };

                        $.ajax({
                            url: '/Login/Login',   // MVC Controller endpoint
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(formData),
                            success: function (response) {
                                if (response.success) {
                                    showToast("Success", response.message, "success", null);
                                    
                                   // Redirect after toast disappears (e.g., 3 seconds)
                                   setTimeout(function () { if (response.redirectUrl) { window.location.href = response.redirectUrl;
                                       // Redirect to new URL
                                       } else { location.reload();
                                           // Or reload the current page if no URL
                                           } }, 3000); // 3000 ms = 3 seconds
                                     // $("#ErrorMessage").html('<div class="alert alert-danger">' + response.message + '</div>');

                                } else {
                                    $("#captchaError").text(response.message);
                                    focusCaptcha();
                                    grecaptcha.reset(); // RESET CAPTCHA
                                    showToast("Error",response.message,"error",null);
                                    $("#LoginForm")[0].reset();
                                    return;
                                     // $("#ErrorMessage").html('<div class="btn btn-success">' + response.message + '</div>');
                                }
                            },
                            error: function () {
                                showToast("Error","Error while signing in. Try again later.","error",null);
                                // $("#ErrorMessage").html('<div class="alert alert-danger">Error while signing up. Try again later.</div>');
                            }
                        });
            }
            else
            {
                return false;
            }
        });

        function focusCaptcha() {
            $('html, body').animate({
                scrollTop: $('#captcha-container').offset().top - 50
            }, 400);

            // visual highlight
            $("#captcha-container").css("border", "2px solid red");

            setTimeout(function () {
                $("#captcha-container").css("border", "none");
            }, 2000);
        }

        function Loader(status)
        {
           switch(status)
           {
               case true:
               $(".js-preloader").show();
               break;
               case false:
               $(".js-preloader").hide();
               break;
           }

        }
    </script>

</body>
</html>