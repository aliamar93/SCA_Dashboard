@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        $(function () {

            function init() {
                bindEvents();
                setupUI("#transportunit");
            }

            function bindEvents() {
                $('#btnView').click(onView);
            }

            function setupUI(tableSelector) {
                initColumnSettings(tableSelector);
            }

            function onView(e) {
                e.preventDefault();
                setupUI("#LoadUnit");
                var id=$(this).attr('data-id');

                // const result = await loadPartialView('/TransportUnit/Detail', { id }, '#Details');
            }

            async function loadPartialView(url, data = {}, containerSelector, loadingText = 'Loading...') {
                try {
                    if (containerSelector) {
                        $(containerSelector).html(`<p>${loadingText}</p>`);
                    }

                    const result = await $.ajax({
                        url: url,
                        type: 'GET',
                        data: data
                    });

                    if (containerSelector) {
                        $(containerSelector).html(result);
                    }
                    // 🔥 Trigger a custom event and pass the container that was updated
                    $(document).trigger('partialViewLoaded', [containerSelector]);

                    return result; // In case you want to use it further

                } catch (err) {
                    console.error('Error loading partial:', err);
                    if (containerSelector) {
                        $(containerSelector).html('<p class="text-danger">Failed to load content.</p>');
                    }
                    return null;
                }
        }

            init();
        });
    </script>
}
