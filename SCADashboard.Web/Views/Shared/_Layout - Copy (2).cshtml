<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyDashboard</title>

    <!-- jQuery (required by DevExtreme) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DevExtreme CSS -->
    <link href="https://cdn3.devexpress.com/jslib/23.2.3/css/dx.light.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">

        <!-- Sidebar -->
        <div class="border-end bg-white" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4 fs-4 fw-bold text-primary">MyDashboard</div>
            <div class="list-group list-group-flush">
                <a href="/" class="list-group-item list-group-item-action list-group-item-light p-3">Home</a>
                <a href="/Products" class="list-group-item list-group-item-action list-group-item-light p-3">Products</a>
                <a href="/Customers" class="list-group-item list-group-item-action list-group-item-light p-3">Customers</a>
                <a href="/Reports" class="list-group-item list-group-item-action list-group-item-light p-3">Reports</a>
                <a href="/Settings" class="list-group-item list-group-item-action list-group-item-light p-3">Settings</a>
            </div>
        </div>
        <!-- /#sidebar-wrapper -->
        <!-- Page content wrapper -->
        <div id="page-content-wrapper">
            <!-- Top navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-primary" id="sidebarToggle">☰</button>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mt-2 mt-lg-0">
                            <li class="nav-item"><a class="nav-link" href="#">Profile</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main content -->
            <div class="container-fluid px-4 mt-4">
                @RenderBody()
            </div>
        </div>
        <!-- /#page-content-wrapper -->

    </div>
    <!-- /#wrapper -->

    <footer class="bg-light text-center py-3 mt-auto border-top">
        &copy; @DateTime.Now.Year - MyDashboard
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DevExtreme JS -->
    <script src="https://cdn3.devexpress.com/jslib/23.2.3/js/dx.all.js"></script>

    <!-- Custom JS -->
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        const wrapper = document.getElementById('wrapper');
        sidebarToggle.addEventListener('click', () => {
            wrapper.classList.toggle('toggled');
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
