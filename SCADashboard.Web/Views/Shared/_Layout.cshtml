        function DualListBox()
        {
              var preselectedListbox = new DualListbox('#preselected-listbox');
        }

         // initializeSelect2();
        function initializeSelect2() {
          $('.js-select2').select2({
              width: '100%',
              placeholder: function () {
                  return $(this).data('placeholder');
              },
              allowClear: true
          });
         }

        function GetPageName(action)
         {
             // Full path: /User/Create
             var fullPath = window.location.pathname;

             // Get just the page name (last segment)
             var pageName = fullPath.substring(fullPath.lastIndexOf('/') + 1);
             return (action.toUpperCase()+' '+pageName.toUpperCase());
         }

        function CheckAction(action)
         {
             switch (action) {
                                     case "View":
                                         // Disable all inputs inside modal
                                         $("#ModalEdit").find('input, textarea, select').prop('disabled', true);
                                         $("#editModal .modal-title").text(GetPageName(action));
                                         $('#SaveUser').hide();
                                         break;
                                     case "Edit":
                                         $("#editModal .modal-title").text(GetPageName(action));
                                         $("#PasswordHash").attr('readonly', true);
                                         $("#Username").attr('readonly', true);
                                         $("#Email").attr('readonly', true);
                                         $('#SaveUser').text('Update').show(); // ensure button is visible
                                         break;
                                     default: // e.g., "Add" or other actions
                                         $("#editModal .modal-title").text(GetPageName(action));
                                         // Change input to type="password"
                                         $("#PasswordHash").attr("type", "password");
                                         $('#SaveUser').text('Save').show(); // reset button
                                         break;
                            }
        }

        function Validation()
        {
            // 👇 VERY IMPORTANT: reinitialize client-side validation
                     if ($.validator && $.validator.unobtrusive) {
                           $.validator.unobtrusive.parse('#createForm');
                             } else {
                               console.error("Unobtrusive validation library is not loaded.");
                             }
        }

    </script>



