         function DeleteModal(Id,action,url,name)
         {
             if(action)
             {
                 $.get(url, { Id: Id }, function (html) {
                  $('#ModalDelete').html(html);
                  $('#DeleteId').val(Id);
                  $('#Deletebtn').attr('url', url);
                  $("#DeleteModal .nk-modal-title").text("Delete record (" + url.split('/')[0] + ") - " + name + "?");
                  $('#DeleteModal').modal("show");
                 });

             }
         }

        $(document).on('partialViewLoaded', function (e, containerSelector) {

            // Re-initialize scripts or plugins here
            initializeDatePickers(containerSelector);

        });

        $(document).on('click', '#Deletebtn', function () {

                var id=$('#DeleteId').val();
                var url = `${$(this).attr('url')}/${id}?Confirm=true`;
                 $.get(url, function (response) {
                    if(response.success)
                    {
                        $('#DeleteModal').modal("hide");
                        // showToast("Success", response.message, "success", null);
                        handleResponse(response);
                    }
                    else
                    {
                        $('#DeleteModal').modal("hide");
                        showToast("Error", response.message, "error", null);
                    }
                 });
            });

        $(document).on('click', '#ChangePassword', function () {
                $('#ChangePasswordModel').modal('show');
         });

        $(document).on('click', '.passcode-switch', function (e) {
            e.preventDefault();
            const targetId = $(this).data('target');
            const input = $('#' + targetId);
            const isPassword = input.attr('type') === 'password';

            // Toggle type
            input.attr('type', isPassword ? 'text' : 'password');

            // Toggle icon visibility
            $(this).find('.icon-show').toggle(!isPassword);
            $(this).find('.icon-hide').toggle(isPassword);
        });


            // Password match validation
        $('#ConfirmPassword, #Password').on('keyup', function () {
            const password = $('#Password').val().trim();
            const confirmPassword = $('#ConfirmPassword').val().trim();

            if (password && confirmPassword && password !== confirmPassword) {
                $('#passwordError').show();
            } else {
                $('#passwordError').hide();
            }
        });

        // Prevent form submit if passwords don't match
        $('#ResetPassword').on('submit', function (e) {
            const password = $('#Password').val().trim();
            const confirmPassword = $('#ConfirmPassword').val().trim();

            if (password !== confirmPassword) {
                e.preventDefault();
                $('#passwordError').show();
                return false;
            }
            else
            {
                $.ajax({
                    url: '/User/ResetPassword',   // MVC Controller endpoint
                    type: 'POST',
                    data: {password:password},
                    success: function (response) {
                        if (response.success) {

                           showToast("Success", response.message, "success", null);
                           // Redirect after toast disappears (e.g., 3 seconds)
                           setTimeout(function () { if (response.redirectUrl) { window.location.href = response.redirectUrl;
                               // Redirect to new URL
                               } else { location.reload();
                                   // Or reload the current page if no URL
                                   } }, 3000); // 3000 ms = 3 seconds
                             // $("#ErrorMessage").html('<div class="alert alert-danger">' + response.message + '</div>');

                        } else {

                            showToast("Error",response.message,"error",null);
                            $("#ResetPassword")[0].reset();
                             // $("#ErrorMessage").html('<div class="btn btn-success">' + response.message + '</div>');
                        }
                    },
                    error: function () {

                        showToast("Error","Error while signing in. Try again later.","error",null);
                        // $("#ErrorMessage").html('<div class="alert alert-danger">Error while signing up. Try again later.</div>');
                    }
                });
            }
        });

        function handleResponse(response, options = {}) {
            /*
            response: {
                success: true/false,
                message: "Message text",
                redirectUrl: "/optional/url"
            }

            options: {
                title: "Title of toast",
                type: "success" | "error" | "info" | "warning",
                duration: 3000 // in milliseconds
            }
            */

            // Default options
            const config = {
                title: options.title || (response.success ? "Success" : "Error"),
                type: options.type || (response.success ? "success" : "error"),
                duration: options.duration || 3000
            };

            // Show toast
            showToast(config.title, response.message, config.type, null);

            // Handle redirect or reload after toast disappears
            setTimeout(function () {
                if (response.redirectUrl) {
                    window.location.href = response.redirectUrl; // redirect if URL provided
                } else if (options.reload !== false) {
                    location.reload(); // reload page if no URL and reload not disabled
                }
            }, config.duration);
        }


