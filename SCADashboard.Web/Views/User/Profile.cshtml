@section Scripts {
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script> *@
    <script>

            $(function(){

            });

            function init()
                {
                  var input = document.querySelector("#PhoneNo");
                  var iti = window.intlTelInput(input, {
                      initialCountry: "auto",
                      geoIpLookup: function(callback) {
                          fetch("https://ipapi.co/json")
                              .then(function(res) { return res.json(); })
                              .then(function(data) { callback(data.country_code); })
                              .catch(function() { callback("DE"); }); // fallback Germany
                      },
                      utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
                  });
                }


            $(document).on('click', '.data-item', async function () {
                var uid=null;
                var elementsWithAttribute =$(this).find('[_id]');
                var property=$(this).find('span.disable')
                uid=$(elementsWithAttribute).attr('_id');
                if(!property.length)
                {
                    const result = await loadPartialView('/User/DetailProfile', { uid }, '#DetailProfile');

                    // Profile Edit Modal Tab Target
                    //var button = $(event.relatedTarget); // Button that triggered the modal
                    var tabTarget = $(this).data('tab-target'); // Extract info from data-tab-target attribute
                    if (tabTarget) {
                        var modal = $('#profileedit');
                        modal.find('.nav-link').removeClass('active');
                        modal.find('.tab-pane').removeClass('active show');
                        // Activate the specified tab
                        modal.find('.nav-link[href="' + tabTarget + '"]').addClass('active');
                        modal.find(tabTarget).addClass('active show');
                    }
                    initializeSelect2();
                    init();
                    $('#profileedit').modal('show');
                }
             });

        async function loadPartialView(url, data = {}, containerSelector, loadingText = 'Loading...') {
                try {
                    if (containerSelector) {
                        $(containerSelector).html(`<p>${loadingText}</p>`);
                    }

                    const result = await $.ajax({
                        url: url,
                        type: 'GET',
                        data: data
                    });

                    if (containerSelector) {
                        $(containerSelector).html(result);
                    }
                    // 🔥 Trigger a custom event and pass the container that was updated
                    $(document).trigger('partialViewLoaded', [containerSelector]);

                    return result; // In case you want to use it further

                } catch (err) {
                    console.error('Error loading partial:', err);
                    if (containerSelector) {
                        $(containerSelector).html('<p class="text-danger">Failed to load content.</p>');
                    }
                    return null;
                }
        }
        
        
        $(document).on("submit", "#UpdateProfileForm", async function (e) {
                    e.preventDefault();

                    const form = $(this);
                    // init();
                    // $("#PhoneNumber").val(iti.getNumber());
                    var parentdiv=form.closest("div");
                    var tabtarget=parentdiv.attr("id");
                    try {
                        const response = await $.ajax({
                            url: form.attr("action"),
                            type: form.attr("method"),
                            data: form.serialize()+ "&tabtarget=" + encodeURIComponent(tabtarget)
                        });

                        if (response.success) {
                            $("#profileedit").modal("hide");
                            handleResponse(response);

                        } else {

                            $("#DetailProfile").html(response);
                        }
                    } catch (error) {
                        console.error("Error saving user:", error);
                        alert("An unexpected error occurred while saving the user.");
                    }
        });
    </script>
}